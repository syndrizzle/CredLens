# Backend only; copy to .env.local for local development. Do not prefix credentials with VITE_.
# Any PostgreSQL 16+ with the pgvector extension. In production, docker-compose.yml builds these itself.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require

# Workers AI model proxy (worker/). Deploy with `bun run worker:deploy`, then set the same
# random token on both sides: `bunx wrangler secret put CREDLENS_AI_TOKEN -c worker/wrangler.jsonc`.
CREDLENS_AI_URL=https://credlens-ai.YOUR-SUBDOMAIN.workers.dev/v1/answer
CREDLENS_AI_TOKEN=CHANGE_ME
